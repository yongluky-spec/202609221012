# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올리지 않습니다.

# 데이터 공급자 우선순위 (기본 krx). 추후: kis, kiwoom  예) DATA_PROVIDER=kis,krx
DATA_PROVIDER=krx

# --- KRX (data.krx.co.kr 계정) ---
KRX_ID=
KRX_PW=

# --- 한국투자증권 (추후 구현) ---
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT_NO=
# KIS_ENV=paper

# --- 키움증권 (추후 구현) ---
